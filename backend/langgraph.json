{
  "node_version": "20",
  "dependencies": ["."],
  "graphs": {
    "deep_researcher": "./src/agents/deep-researcher.ts:deepResearcherGraph",
    "chatbot": "./src/agents/chatbot.ts:chatbotGraph",
    "math_agent": "./src/agents/math-agent.ts:mathAgentGraph",
    "mcp_agent": "./src/agents/mcp-agent.ts:mcpAgentGraph"
  },
  "http": {
    "app": "./src/operations/http-app.ts:operationsHttpApp",
    "configurable_headers": {
      "includes": [
        "x-request-id",
        "x-idempotency-key",
        "x-active-run-id",
        "x-active-run-generation",
        "x-bff-principal-id",
        "x-bff-principal-type",
        "x-bff-tenant-id",
        "x-bff-roles",
        "x-bff-scopes",
        "x-bff-auth-source",
        "x-bff-authenticated-at",
        "x-bff-scope-id",
        "x-bff-scope-type"
      ]
    }
  },
  "env": ".env"
}
