{
  "name": "chat-gun-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "HsienW",
  "scripts": {
    "dev": "langgraphjs dev",
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run migrations:check && tsc -p tsconfig.json --noEmit",
    "migrations:check": "tsx src/runtime/persistence/migration-additive.cli.ts",
    "migrations:up": "tsx src/runtime/persistence/migrate-up.cli.ts",
    "postinstall": "patch-package",
    "start": "langgraphjs dev",
    "test": "vitest run",
    "eval:opik": "vitest run src/evaluation/opik/experiment.live-smoke.test.ts",
    "knowledge:corpus": "tsx scripts/knowledge/generate-synthetic-corpus.ts",
    "knowledge:ingest": "tsx src/knowledge/ingest.cli.ts",
    "knowledge:eval-dataset": "tsx scripts/knowledge/build-eval-dataset.ts",
    "knowledge:evaluate": "tsx src/knowledge/evaluation/evaluate.cli.ts",
    "commerce:eval-dataset": "tsx scripts/commerce/build-chain-eval-dataset.ts",
    "commerce:evaluate": "tsx src/evaluation/commerce/evaluate.cli.ts",
    "operations:release-gate": "tsx src/operations/release-gate.cli.ts",
    "operations:feedback-loop": "tsx src/operations/feedback-loop.cli.ts",
    "operations:rolling-deploy": "tsx src/operations/rolling-deploy.cli.ts"
  },
  "dependencies": {
    "@gun-ai/harness-contracts": "0.1.0-alpha.3",
    "@gun-ai/harness-kernel": "0.1.0-alpha.3",
    "@gun-ai/harness-sdk": "0.1.0-alpha.3",
    "@gun-ai/harness-testkit": "0.1.0-alpha.3",
    "@langchain/core": "1.2.10",
    "@langchain/langgraph": "1.4.14",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@langchain/langgraph-checkpoint-postgres": "1.0.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server-filesystem": "^2026.1.14",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "dotenv": "^16.5.0",
    "hono": "^4.12.23",
    "ioredis": "^6.0.0",
    "pg": "^8.22.0",
    "undici": "^8.4.1",
    "zod": "^3.25.32"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "1.4.5",
    "@types/node": "^22.15.17",
    "@types/pg": "^8.20.0",
    "patch-package": "8.0.0",
    "typescript": "~5.7.2",
    "vitest": "^4.1.8"
  },
  "optionalDependencies": {
    "opik": "^1.11.14"
  }
}
